{
  "audio_event": "curator_warning",
  "captions": [
    {"time": 0.0, "speaker": "ARCHIVE", "text": "After humanity's final collapse, the Last World Museum was built outside normal time."},
    {"time": 3.0, "speaker": "CURATOR", "text": "Purpose: preserve every age of human existence from origin to ending."},
    {"time": 6.0, "speaker": "ARCHIVE", "text": "But the museum did not preserve only facts. It preserved myths, fears, propaganda, and unfinished guilt."},
    {"time": 9.5, "speaker": "ARCHIVE", "text": "For centuries, the museum kept history still. Then the exhibits began remembering the doors."},
    {"time": 13.0, "speaker": "CURATOR", "text": "Contradiction levels exceed preservation limits. Docent units one through sixteen: offline."},
    {"time": 16.0, "speaker": "ARCHIVE", "text": "Only one worker remained outside the catalog. No origin record. No exhibit tag."},
    {"time": 19.0, "speaker": "CURATOR", "text": "Docent unit seventeen: responsive."},
    {"time": 21.5, "speaker": "ARCHIVE", "text": "In the western wing, a plague bell rang where no bell should ring."},
    {"time": 24.0, "speaker": "CURATOR", "text": "Wake."}
  ],
